table Document {
    id: ulong;
    text: string;      // 原始文本片段 (RAG chunk)
    source: string;     // 来源文件名，便于溯源

    /// BAAI/bge-m3 输出 1024 维向量，使用余弦相似度做 HNSW 近似最近邻检索。
    /// objectbox: index=hnsw, hnsw-dimensions=1024
    /// objectbox: hnsw-distance-type=Cosine
    embedding: [float];
}

root_type Document;
